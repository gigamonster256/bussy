{
  "name": "bussy",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.5",
  "license": "MIT",
  "description": "Texas A&M bus arrival notification service",
  "scripts": {
    "build": "bun run build:server && bun run build:client",
    "build:server": "bun build src/Program.ts --outdir dist/server --target bun --minify",
    "build:client": "bun scripts/build-client.ts",
    "build:client:dev": "bun scripts/build-client.ts --dev",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "check:server": "tsc -p tsconfig.server.json --noEmit",
    "check:client": "tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint \"**/{src,test,scripts}/**/*.{ts,tsx,mjs}\"",
    "lint:fix": "bun run lint --fix",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "dev": "bun run build:client:dev && bun --watch src/Program.ts",
    "dev:client": "bun scripts/build-client.ts --dev --watch",
    "dev:all": "bun run dev:client & bun run dev",
    "start": "bun dist/server/Program.js",
    "start:dev": "bun src/Program.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@effect/opentelemetry": "^0.60.0",
    "@effect/platform": "^0.94.1",
    "@effect/platform-bun": "^0.87.0",
    "@effect/platform-node": "^0.104.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.208.0",
    "@opentelemetry/sdk-logs": "^0.208.0",
    "@opentelemetry/sdk-metrics": "^2.2.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@opentelemetry/sdk-trace-node": "^2.2.0",
    "@opentelemetry/sdk-trace-web": "^2.2.0",
    "aggie-spirit-api": "^1.3.4",
    "drizzle-orm": "^0.45.1",
    "effect": "^3.17.7",
    "mysql2": "^3.16.0",
    "solid-js": "^1.9.10",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-typescript": "^7.28.5",
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/language-service": "latest",
    "@effect/vitest": "^0.25.1",
    "@eslint/compat": "1.1.1",
    "@eslint/eslintrc": "3.1.0",
    "@eslint/js": "9.10.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.3.5",
    "@types/node": "^22.5.2",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.23",
    "babel-preset-solid": "^1.9.10",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.10.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-codegen": "^0.28.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-destructure-keys": "^2.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.6.2"
  }
}
