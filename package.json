{
  "name": "bussy",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "license": "MIT",
  "description": "Texas A&M bus arrival notification service",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@tsconfig/bun": "1.0.9",
      "@types/bun": "latest",
      "@effect/platform": "0.96.0",
      "@effect/platform-bun": "0.89.0",
      "@effect/sql": "0.51.0",
      "@effect/sql-drizzle": "0.50.0",
      "@effect/sql-mysql2": "0.52.0",
      "@effect/language-service": "0.85.1",
      "effect": "3.21.0",
      "oxlint": "1.60.0",
      "typescript": "6.0.3"
    }
  },
  "scripts": {
    "build": "bun --filter '*' build",
    "lint": "oxlint",
    "fmt": "bun x oxfmt --write --ignore-path .oxfmtignore",
    "build:api": "bun --filter @bussy/api build",
    "build:server": "bun --filter server build",
    "build:web": "bun --filter web build",
    "check": "bun --filter '*' check",
    "check:api": "bun --filter @bussy/api check",
    "check:server": "bun --filter server check",
    "dev": "bun --filter '*' --parallel dev",
    "dev:server": "bun --filter server dev",
    "dev:web": "bun --filter web dev",
    "test": "bun --filter '*' test"
  },
  "devDependencies": {
    "oxfmt": "^0.45.0",
    "oxlint": "catalog:",
    "@types/bun": "catalog:",
    "@tsconfig/bun": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
