# Bussy Environment Variables

# Server
PORT=3000

# Database (MySQL/MariaDB)
DATABASE_URL=mysql://bussy:bussy@localhost:3306/bussy

# VAPID keys for Web Push notifications
# Generate new keys with: bunx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=your-public-key-here
VAPID_PRIVATE_KEY=your-private-key-here
VAPID_SUBJECT=mailto:admin@example.com

# API caching (optional - defaults shown)
# API_AUTH_CACHE_TTL="6 hours"
# API_METADATA_TTL="1 hour"
