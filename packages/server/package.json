    "@effect/sql": "catalog:",
    "@effect/sql-drizzle": "catalog:",
    "@effect/sql-mysql2": "catalog:",
    "@types/web-push": "^3.6.4",
    "drizzle-orm": "1.0.0-beta.20",
    "effect": "catalog:",
    "mysql2": "^3.20.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "^0.29.0",
    "drizzle-kit": "1.0.0-beta.20",
