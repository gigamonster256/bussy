{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc -b tsconfig.json",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "build": "bun build src/Program.ts --outdir dist/server --target bun --minify",
    "dev": "bun --watch src/Program.ts",
    "start": "bun dist/server/Program.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@bussy/api": "workspace:*",
    "@effect/platform": "^0.96.0",
    "@effect/platform-bun": "^0.89.0",
    "@effect/sql": "^0.51.0",
    "@effect/sql-drizzle": "^0.50.0",
    "@effect/sql-mysql2": "^0.52.0",
    "aggie-spirit-api": "^1.3.4",
    "drizzle-orm": "^1.0.0-beta.20",
    "effect": "^3.21.0",
    "mysql2": "^3.20.0",
    "ulid": "^3.0.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@effect/language-service": "latest",
    "@effect/vitest": "^0.29.0",
    "@types/bun": "^1.3.5",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^1.0.0-beta.20",
    "oxlint": "^1.55.0",
    "typescript": "^5.6.2",
    "vitest": "^3.0.0"
  }
}