{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc -b tsconfig.json",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "build": "bun build src/Program.ts --outdir dist/server --target bun --minify",
    "dev": "bun --watch src/Program.ts",
    "start": "bun dist/server/Program.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@effect/platform": "^0.94.1",
    "@effect/platform-bun": "^0.87.0",
    "aggie-spirit-api": "^1.3.4",
    "drizzle-orm": "^0.45.1",
    "effect": "^3.17.7",
    "mysql2": "^3.16.0",
    "ulid": "^3.0.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@effect/language-service": "latest",
    "@effect/vitest": "^0.25.1",
    "@types/bun": "^1.3.5",
    "@types/node": "^22.5.2",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.8",
    "oxlint": "^1.55.0",
    "typescript": "^5.6.2",
    "vitest": "^3.0.0"
  }
}