{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:sw:dev && vite",
    "check": "tsc --noEmit",
    "build": "vite build",
    "build:sw": "bun build src/sw.ts --outdir=dist --outfile=sw.js --target=browser --format=esm",
    "build:sw:dev": "bun build src/sw.ts --outdir=public --outfile=sw.js --target=browser --format=esm",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@bussy/api": "workspace:*",
    "@effect/platform": "catalog:",
    "@tailwindcss/vite": "^4.2.1",
    "effect": "catalog:",
    "solid-js": "^1.9.11",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.10"
  }
}
